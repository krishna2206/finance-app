{
  "name": "finance-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:backend": "cd backend && bun run dev",
    "dev:web": "cd web && bun run dev",
    "build": "cd web && bun run build",
    "start": "bun run build && cd backend && bun run start",
    "backup": "cd backend && bun run backup",
    "test": "cd backend && bun test",
    "typecheck": "bun --filter \"*\" typecheck"
  }
}
